#
# cmake-modules/ufsrv_config_install_ufnetcorelib.cmake
#
# Install step — copies generated files from generator staging into the
# tracked deep paths.  Regenerates the master include with LOCAL-appropriate
# relative paths (quoted for co-located .c files, angle-bracket for headers).
#
# Invoked via cmake -P:
#   cmake -DSTAGING=<staging-dir> -DINSTALL_HDR=<public-generated-dir>
#         -DINSTALL_SRC=<private-generated-dir>
#         -P cmake-modules/ufsrv_config_install_ufnetcorelib.cmake
#

cmake_minimum_required(VERSION 3.20)

# ── Create destination directories ──────────────────────────────────
file(MAKE_DIRECTORY "${INSTALL_HDR}")
file(MAKE_DIRECTORY "${INSTALL_SRC}")

# ── Public generated headers (2 files, verbatim) ────────────────────
foreach(_F IN ITEMS
    ufsrv_config_field_enums_generated.h
    ufsrv_config_accessor_decls_generated.h
)
    file(COPY "${STAGING}/${_F}" DESTINATION "${INSTALL_HDR}")
endforeach()

# ── Private generated sources (verbatim) ────────────────────────────
foreach(_F IN ITEMS
    data_ufsrv_config_field_tables_generated.c
    ufsrv_config_accessor_defs_generated.c
    ufsrv_config_validate_generated.c
    data_ufsrv_config_literal_to_field_map_priv_generated.h
    data_ufsrv_config_dispatch_table_priv_generated.h
)
    if(EXISTS "${STAGING}/${_F}")
        file(COPY "${STAGING}/${_F}" DESTINATION "${INSTALL_SRC}")
    endif()
endforeach()

# ── Master include — regenerated with LOCAL-appropriate paths ────────
# The generator's version uses angle-bracket paths for .c-including-.c
# (e.g. <ufsrvcorelib/.../generated/data_...c>), which would resolve
# to the include/ tree (no .c files there).  Regenerate with quoted
# relative paths for co-located .c files and angle-bracket for headers.
file(WRITE "${INSTALL_SRC}/ufsrv_config_getters_setters_generated.c"
    "/* Master include — pulls in all decomposed generated source files.\n"
    " * Generated by ufsrv_config_install_ufnetcorelib.\n"
    " */\n"
    "#include <ufsrvcorelib/ufsrv_core/ufsrv_config/generated/ufsrv_config_field_enums_generated.h>\n"
    "#include <ufsrvcorelib/ufsrv_core/ufsrv_config/generated/ufsrv_config_accessor_decls_generated.h>\n"
    "#include \"data_ufsrv_config_field_tables_generated.c\"\n"
    "#include \"ufsrv_config_accessor_defs_generated.c\"\n"
    "#include \"ufsrv_config_validate_generated.c\"\n"
)

message(STATUS "ufsrv_config_install: installed to tracked deep paths")
